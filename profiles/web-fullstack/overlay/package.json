{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "playwright test tests/e2e",
    "test:smoke": "playwright test tests/smoke",
    "validate": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "project:check": "node scripts/check-project-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
